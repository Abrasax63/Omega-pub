{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Omega P5 per-call telemetry record",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "experiment_id",
    "case_id",
    "arm",
    "call_id",
    "provider",
    "model",
    "started_at",
    "elapsed_seconds",
    "status",
    "input_tokens",
    "output_tokens",
    "cached_input_tokens",
    "token_usage_source",
    "cost_usd",
    "cost_source",
    "tool_calls",
    "result_validation_status"
  ],
  "properties": {
    "schema_version": {
      "const": "omega.telemetry.call.v1"
    },
    "experiment_id": {
      "type": "string",
      "minLength": 1
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "arm": {
      "enum": [
        "A",
        "B",
        "C"
      ]
    },
    "call_id": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "model_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "provider_request_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "elapsed_seconds": {
      "type": "number",
      "minimum": 0
    },
    "status": {
      "enum": [
        "completed",
        "failed",
        "timeout"
      ]
    },
    "input_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "output_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "cached_input_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "token_usage_source": {
      "enum": [
        "provider_response",
        "provider_export",
        "unavailable"
      ]
    },
    "cost_usd": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "cost_source": {
      "enum": [
        "provider_reported",
        "provider_export",
        "computed_from_rate_card",
        "unavailable"
      ]
    },
    "tool_calls": {
      "type": "integer",
      "minimum": 0
    },
    "cpu_seconds": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "peak_memory_bytes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "io_read_bytes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "io_write_bytes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "result_validation_status": {
      "enum": [
        "not_assessed",
        "validated",
        "rejected",
        "indeterminate"
      ]
    },
    "validation_ref": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
