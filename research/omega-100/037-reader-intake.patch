@@ -0,0 +1,56 @@
+"""Validate model JSON and keep rejected inputs available for local review."""
+
+import hashlib
+import json
+from pathlib import Path
+import tempfile
+
+
+class DuplicateKey(ValueError):
+    pass
+
+
+class RejectedJSON(ValueError):
+    def __init__(self, reason, stage, raw):
+        super().__init__(reason)
+        self.reason = reason
+        self.stage = stage
+        self.raw = raw
+
+    def report(self, directory: Path | None = None):
+        digest = hashlib.sha256(self.raw).hexdigest()
+        result = {
+            "status": "MODEL_JSON_REJECTED",
+            "reason": self.reason,
+            "stage": self.stage,
+            "sha256": digest,
+            "next_action": "REQUEST_UNAMBIGUOUS_JSON",
+        }
+        if directory is not None:
+            try:
+                with tempfile.NamedTemporaryFile(mode="wb", dir=directory,
+                        prefix=f"rejected-{digest[:12]}-", suffix=".bin", delete=False) as stream:
+                    stream.write(self.raw)
+                result["review_file"] = stream.name
+            except OSError:
+                result["archive_status"] = "NOT_SAVED"
+        return result
+
+
+def unique_object(pairs):
+    result = {}
+    for key, value in pairs:
+        if key in result:
+            raise DuplicateKey
+        result[key] = value
+    return result
+
+
+def decode(data: bytes | str, stage: str, *, original: bytes):
+    try:
+        text = data.decode("utf-8") if isinstance(data, bytes) else data
+        return json.loads(text, object_pairs_hook=unique_object)
+    except DuplicateKey as error:
+        raise RejectedJSON("DUPLICATE_JSON_KEY", stage, original) from error
+    except (ValueError, RecursionError) as error:
+        raise RejectedJSON("INVALID_JSON", stage, original) from error
