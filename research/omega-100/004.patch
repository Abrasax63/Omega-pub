+def without_inline_code(line: str) -> str:
+    """Hide closed, same-line code spans from delimiter detection."""
+    runs = list(CODE_TICKS.finditer(line))
+    next_by_length = {}
+    closing_indices = [None] * len(runs)
+    for index in range(len(runs) - 1, -1, -1):
+        length = len(runs[index][0])
+        closing_indices[index] = next_by_length.get(length)
+        next_by_length[length] = index
+
+    parts = []
+    offset = 0
+    index = 0
+    while index < len(runs):
+        closing = closing_indices[index]
+        if closing is None:
+            index += 1
+            continue
+        parts.append(line[offset:runs[index].start()])
+        parts.append(" ")
+        offset = runs[closing].end()
+        index = closing + 1
+    parts.append(line[offset:])
+    return "".join(parts)
+
+
 def packetize(raw: bytes, source_path: str) -> dict:
