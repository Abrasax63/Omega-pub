{
  "schema": "OMEGA_SELF_TEACH04_TRAIN_V1",
  "provenance": "DEVELOPER_GENERATED_SYNTHETIC",
  "train": [
    {
      "id": "R1",
      "family": "identical_character_maximal_runs",
      "goal": "Partition the entire input string into maximal contiguous runs of exactly equal characters (case and punctuation matter). Return one string per run: the character, a colon, and the decimal run length. Never omit the final run. Return [] for empty input.",
      "public_examples": [
        {
          "input": "",
          "expected": []
        },
        {
          "input": "aaBB?",
          "expected": [
            "a:2",
            "B:2",
            "?:1"
          ]
        },
        {
          "input": "x",
          "expected": [
            "x:1"
          ]
        },
        {
          "input": "!!xxy",
          "expected": [
            "!:2",
            "x:2",
            "y:1"
          ]
        },
        {
          "input": "a1a",
          "expected": [
            "a:1",
            "1:1",
            "a:1"
          ]
        }
      ],
      "development_cases": [
