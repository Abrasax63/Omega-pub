    {
      "id": "R2",
      "family": "digit_spans_minimum_two",
      "goal": "Scan the input left to right. For each maximal contiguous run of ASCII digits 0-9 of length at least 2, append exactly the original digit substring, preserving leading zeros. A nondigit ends a run. Ignore one-digit runs. Never forget a qualifying final run. Return a list of strings.",
      "public_examples": [
